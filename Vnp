-- Vòng Lặp Xả Đạn (Dynamic Timer - Lõi Chống Ping Tuyệt Đối)
task.spawn(function()
    while true do
        local delayTime = 0.1 -- Base Delay (10 lần/giây)
        
        if Config.BuffEnabled and #ArmorCache > 0 then
            pcall(function()
                local pingItem = Stats.Network.ServerStatsItem:FindFirstChild("Data Ping")
                local ping = pingItem and pingItem:GetValue() or 50 
                local targetMult = Config.BuffMult
                
                -- Phanh Động Cơ Kép (Giảm đạn & Tăng thời gian chờ)
                if not Config.BypassPing then
                    if ping > 400 then 
                        targetMult = math.floor(Config.BuffMult / 5) 
                        delayTime = 1.0 -- Lag quá thì 1 giây mới cho bắn 1 lần
                    elseif ping > 150 then
                        targetMult = math.floor(Config.BuffMult / 2) 
                        delayTime = 0.4 -- Hơi lag thì 0.4 giây bắn 1 lần
                    end
                end
                
                if targetMult < 1 then targetMult = 1 end
                Config.CurrentOutput = targetMult
                Config.CurrentDelay = delayTime
                
                -- Bắn Đạn Bằng Thread Riêng Của Delta
                for _, r in ipairs(ArmorCache) do 
                    task.spawn(function()
                        for i = 1, targetMult do 
                            pcall(function() r:FireServer() end) 
                        end
                    end)
                end
            end)
        end
        
        -- Dùng Delay Động Để Tránh Chặn Server
        task.wait(delayTime)
    end
end)

